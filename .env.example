# --- Database ---------------------------------------------------------------
GO2_DATABASE_URL=postgresql+psycopg://go2:go2@localhost:5433/go2

# --- Alibaba Model Studio (Singapore endpoint) ------------------------------
# https://modelstudio.console.alibabacloud.com/  -> API keys
# Singapore, NOT Beijing: different data jurisdiction, and the free quota is
# only on the international endpoint.
GO2_DASHSCOPE_API_KEY=
GO2_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GO2_MODEL_GENERAL=qwen-plus
GO2_MODEL_HARD=qwen3-max
GO2_MODEL_OCR=qwen-vl-ocr

# --- Retrieval stack --------------------------------------------------------
# "local" runs Qwen3 + a cross-encoder on this machine: free, private, and it
# saturates the CPU while ingesting. "jina" sends document text and queries to
# the API: fast and near-free at small scale, but the text leaves the machine.
# Switching providers invalidates every existing vector -- documents must be
# re-ingested, and search will report nothing found until they are.
GO2_EMBEDDING_PROVIDER=local
GO2_RERANK_PROVIDER=local

# What happens to sensitive values before text leaves the machine.
#   redact — mask them, send the rest (default)
#   block  — refuse to send content containing PII to an external provider
#   allow  — send as-is, an explicit opt-out
# Irrelevant under the local provider: nothing leaves at all.
GO2_PII_POLICY=redact
# Also redact passages returned through the MCP tools. Off by default, since
# those answer your own question about your own documents.
GO2_PII_REDACT_TOOL_OUTPUT=false

# Free key (10M tokens) from https://jina.ai
GO2_JINA_API_KEY=
GO2_JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
GO2_JINA_RERANK_MODEL=jina-reranker-v3.5

GO2_EMBEDDING_MODEL=electroglyph/Qwen3-Embedding-0.6B-onnx-uint8
GO2_EMBEDDING_DIM=1024
GO2_INFERENCE_THREADS=2

# --- Credential encryption --------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GO2_FERNET_KEY=

# --- Google Drive OAuth -----------------------------------------------------
# Consent screen must be Internal/Testing while drive.readonly is in use.
GO2_GOOGLE_CLIENT_SECRETS=.secrets/google_client_secret.json

# --- Langfuse (optional at M0) ----------------------------------------------
GO2_LANGFUSE_PUBLIC_KEY=
GO2_LANGFUSE_SECRET_KEY=
GO2_LANGFUSE_HOST=https://cloud.langfuse.com
