# --- Database ---------------------------------------------------------------
GO2_DATABASE_URL=postgresql+psycopg://go2:go2@localhost:5433/go2

# --- Alibaba Model Studio (Singapore endpoint) ------------------------------
# https://modelstudio.console.alibabacloud.com/  -> API keys
# Singapore, NOT Beijing: different data jurisdiction, and the free quota is
# only on the international endpoint.
GO2_DASHSCOPE_API_KEY=
GO2_DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GO2_MODEL_GENERAL=qwen-plus
GO2_MODEL_HARD=qwen3-max
GO2_MODEL_OCR=qwen-vl-ocr

# --- Local retrieval stack (no API, no cost) --------------------------------
GO2_EMBEDDING_MODEL=electroglyph/Qwen3-Embedding-0.6B-onnx-uint8
GO2_EMBEDDING_DIM=1024

# --- Credential encryption --------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GO2_FERNET_KEY=

# --- Google Drive OAuth -----------------------------------------------------
# Consent screen must be Internal/Testing while drive.readonly is in use.
GO2_GOOGLE_CLIENT_SECRETS=.secrets/google_client_secret.json

# --- Langfuse (optional at M0) ----------------------------------------------
GO2_LANGFUSE_PUBLIC_KEY=
GO2_LANGFUSE_SECRET_KEY=
GO2_LANGFUSE_HOST=https://cloud.langfuse.com
