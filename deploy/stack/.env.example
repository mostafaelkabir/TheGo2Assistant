# Configuration for the one-command stack. Copy to .env beside this file.
#
# Five values are required and have no default: the go2 token and the four
# LibreChat secrets. `docker compose up` refuses to start without them and
# names the one that is missing. Generate them with:
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'      # GO2_HTTP_TOKEN
#   openssl rand -hex 32                                                # CREDS_KEY, JWT_SECRET, JWT_REFRESH_SECRET
#   openssl rand -hex 16                                                # CREDS_IV
#
# Set the LibreChat secrets before the first registration. Accounts created
# against temporary values stop working when the values change.

# --- go2 --------------------------------------------------------------------

# The workspace this stack serves. One tenant per stack, the same rule as one
# tenant per serving process: the token says "may you talk to this server",
# never "which workspace". `init` creates it if it does not exist.
GO2_TENANT=demo

# Every request to the server must carry this as a bearer token. Required:
# inside the stack the server binds the container's interface, and go2
# refuses to bind beyond loopback without one.
GO2_HTTP_TOKEN=

# Port on this machine that reaches the MCP server, loopback only. Used by
# the smoke test and by a client on this machine such as Claude Code. 8770
# rather than 8765 so it does not collide with a `go2 serve --http` started
# by hand.
GO2_PORT=8770

# Where embedding and reranking run. "local" keeps every document inside the
# stack and downloads 1.7 GB of weights on first boot; "jina" sends document
# text and queries to the Jina API and needs GO2_JINA_API_KEY. Switching
# providers makes existing vectors unsearchable until documents are
# re-ingested.
GO2_EMBEDDING_PROVIDER=local
GO2_RERANK_PROVIDER=local
GO2_JINA_API_KEY=

# Alibaba Model Studio, Singapore endpoint. LibreChat uses this key for the
# Qwen models that answer in the browser; go2 will use it for OCR (T-018).
# Keys are region-bound: a Beijing key fails against the Singapore URL
# rather than silently routing documents through another jurisdiction.
GO2_DASHSCOPE_API_KEY=

# What happens to sensitive values before text leaves the machine, and
# whether passages returned through the tools are redacted. Turn the second
# on when the reader is not the owner of the documents.
GO2_PII_POLICY=redact
GO2_PII_REDACT_TOOL_OUTPUT=false

# Inference budget. Bounded on purpose: fastembed's default batch of 256 cost
# 24 GB resident on a 16 GB machine and computed nothing. Docker Desktop's VM
# is usually smaller than the host; leave these unless you have measured.
GO2_EMBEDDING_BATCH_SIZE=4
GO2_INFERENCE_THREADS=2

# A directory that already holds the model weights, to skip the download.
# Leave empty for a named volume the stack fills on first boot.
GO2_MODELS_DIR=

# A folder on this machine to index, mounted read-only at /data inside the
# stack. Index it with `docker compose run --rm server ingest /data`.
GO2_INGEST_DIR=./samples

# Needed only once Google Drive is connected (T-011). Generate with
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GO2_FERNET_KEY=

# --- LibreChat --------------------------------------------------------------

# The browser UI, at http://localhost:3080 by default.
LIBRECHAT_PORT=3080

# Required. See the top of this file.
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
